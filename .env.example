# Copy this file to .env and fill in values for local development.
# Never commit .env — it is in .gitignore.

# Flask secret key — change this to a long random string in production
SECRET_KEY=dev-secret-change-in-production

# SQLite database path (default creates instance/osteo.db automatically)
# DATABASE_URL=sqlite:///osteo.db

# Path to the trained EfficientNetB0 model weights
# MODEL_PATH=model/osteoporosis_efficientnetb0.keras
